+    const auto result = i2s_channel_write(tx_handle_, buffer.get(), data.size() * sizeof(int32_t),
+                                        &written, static_cast<uint32_t>(remaining / 1000));
+    return result == ESP_OK && written == data.size() * sizeof(int32_t) &&
+           esp_timer_get_time() - start <= kDeadlineUs;
+}
