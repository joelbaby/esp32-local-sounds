+// Shared output ownership, independent of algorithms and optional feature assets.
+bool AudioService::ControlLocalAudio(local_audio::Source& source,
+                                     const std::function<bool()>& update) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    if (service_stopped_.load() || (local_source_ && local_source_ != &source) || !update())
+        return false;
+    if (local_source_ != &source) ++local_source_epoch_;
+    local_source_ = &source;
+    ++playback_generation_;
+    audio_decode_queue_.clear();
+    audio_playback_queue_.clear();
+    audio_testing_queue_.clear();
+    playback_drained_notified_ = false;
+    audio_queue_cv_.notify_all();
+    return true;
+}
+void AudioService::StopLocalAudio(local_audio::Source* expected) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    if (local_source_ && (!expected || local_source_ == expected)) local_source_->Stop();
+    audio_queue_cv_.notify_all();
+}
+bool AudioService::IsLocalAudioActive() {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return local_source_ && (local_source_->active() || output_in_flight_);
+}
+bool AudioService::LocalAudioFailed() {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return local_source_ && local_source_->failed();
+}
+std::string AudioService::LocalAudioStatus(const local_audio::Source& source) {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    return source.StatusJson();
+}
+void AudioService::ReleaseLocalAudio(local_audio::Source* expected) {
+    bool drained = false;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        if (expected && local_source_ != expected) return;
+        if (local_source_ && (local_source_->active() || output_in_flight_)) return;
+        local_source_ = nullptr;
+        drained = MarkPlaybackDrainedLocked();
+        audio_queue_cv_.notify_all();
+    }
+    if (drained && callbacks_.on_playback_drained) callbacks_.on_playback_drained();
+}
