+bool NoAudioCodec::OutputGeneratedData(std::vector<int16_t>& data) {
+    if (data.empty()) return true;
+    if (data.size() > 240) return false;
+    // Full-frame conversion, deliberately not a persistent/chunked scratch buffer.
+    // This deadline covers waiting for the shared I2S lock and the driver call.
+    constexpr int64_t kDeadlineUs = 100000;
